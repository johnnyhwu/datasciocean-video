     "hold": 0.3,
     "screen": []
    },
    {
     "id": "i5",
     "display": "與其說 Claude Code 是一個會開檔案的聊天機器人，",
     "hold": 0.1,
     "screen": []
    },
    {
     "id": "i6",
     "display": "不如說是圍著這顆模型，搭起來的一整套執行架構：Harness。",
     "hold": 0.4,
     "screen": [
      "Harness"
     ]
    }
   ]
  },
